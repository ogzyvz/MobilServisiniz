# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables / secrets (never commit real values)
.env
.env.*
!.env.example

# Node
node_modules/
.next/

# .NET build output (regenerated by `dotnet build` / `dotnet publish`)
**/bin/
**/obj/

# ASP.NET Core secrets (contain real DB connection string / JWT key)
# See appsettings.json.example / appsettings.Production.json.example for templates
api/OtoServis.Api/appsettings.json
api/OtoServis.Api/appsettings.Production.json
api/OtoServis.Admin/appsettings.json
api/OtoServis.Admin/appsettings.Production.json
api/OtoServis.Platform/appsettings.json
api/OtoServis.Platform/appsettings.Production.json

# Real AI provider keys (setup notes with live API keys)
publish/AI-ANAHTARLAR.txt

# Real customer/shop provisioning scripts (contain live phone/password hash)
publish/add_shop_oto_balkan.sql

# Cloudflare Origin CA sertifikasi ve ozel anahtari (asla commit edilmez)
publish/iis-setup/cf-origin.pem
publish/iis-setup/cf-origin.key
publish/iis-setup/cf-origin.pfx
publish/iis-setup/*.pfx
publish/iis-setup/pfx-password.txt

# Published deploy output (regenerated via api/deploy.ps1 or dotnet publish, mirrors source+bin)
publish/admin/
publish/api/
publish/api-out/
publish/platform/
publish/_out_admin/
publish/_out_api/
publish/_out_platform/
publish/RDP-DEPLOY/
api/publish/
publish/*.zip
*-publish.zip

# Local run logs (not useful, regenerated by running the app)
publish/api-local-out.txt
publish/api-local-err.txt

# Compiled release artifacts - never commit large binaries
*.apk
*.aab
*.zip

# Mobile (Expo/React Native) - see mobile/.gitignore for additional rules
mobile/node_modules/
mobile/.expo/
mobile/android/
mobile/ios/

# Docs tooling (puppeteer, etc.)
docs/node_modules/

# Logs
*.log

# Editors / OS
.vs/
.vscode/
.DS_Store
