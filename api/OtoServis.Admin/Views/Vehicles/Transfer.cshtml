@model VehicleTransferViewModel
@{
    ViewData["Title"] = "Araç Devret";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small text-muted">← Araç listesi</a>
    <h1 class="page-title mt-1">@ViewData["Title"]</h1>
</div>

<div class="card-panel p-4" style="max-width:600px">
    <p class="mb-1"><strong>Plaka:</strong> @Model.Plate</p>
    <p class="mb-3"><strong>Şu anki sahibi:</strong> @Model.CurrentCustomerName</p>

    <form asp-action="Transfer" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VehicleId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="NewCustomerId" class="form-label fw-semibold"></label>
            <select asp-for="NewCustomerId" asp-items="Model.Customers" class="form-select">
                <option value="">-- Seçiniz --</option>
            </select>
            <span asp-validation-for="NewCustomerId" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4" style="background:#2f4a86;border:0">Devret</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
