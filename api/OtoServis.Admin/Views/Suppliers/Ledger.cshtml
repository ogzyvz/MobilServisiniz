@model SupplierLedgerViewModel
@{
    ViewData["Title"] = $"Cari Hesap — {Model.SupplierName}";
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success py-2">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2">@err</div>
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small text-muted">← Cari listesi</a>
    <h1 class="page-title mt-1">@Model.SupplierName</h1>
    <p class="text-muted mb-0">@(Model.Phone ?? "-")</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="label">Güncel Bakiye</div>
            <div class="value @(Model.Balance > 0 ? "text-warning" : "")" style="font-size:1.4rem">@Model.Balance.ToString("N2") ₺</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card-panel overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Tür</th>
                            <th>Açıklama</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Transactions.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Hareket bulunamadı.</td></tr>
                    }
                    @foreach (var t in Model.Transactions)
                    {
                        var label = t.Type switch { "alis" => "Alış", "odeme" => "Ödeme", "iade" => "İade", _ => t.Type };
                        var badgeClass = t.Type switch { "alis" => "text-bg-warning", "odeme" => "text-bg-success", "iade" => "text-bg-info", _ => "text-bg-light" };
                        <tr>
                            <td class="text-muted small">@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="badge @badgeClass">@label</span></td>
                            <td class="text-muted small">@(t.Description ?? "-")</td>
                            <td class="text-end fw-semibold">@t.Amount.ToString("N2") ₺</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-panel p-4">
            <h2 class="h6 fw-bold mb-3">Ödeme Ekle</h2>
            <form asp-action="RecordPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Payment.SupplierId" />
                <div class="mb-3">
                    <label asp-for="Payment.Amount" class="form-label fw-semibold"></label>
                    <input asp-for="Payment.Amount" class="form-control" type="number" step="0.01" />
                </div>
                <div class="mb-3">
                    <label asp-for="Payment.Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Payment.Description" class="form-control" rows="2"></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100" style="background:#2f4a86;border:0">Ödeme Kaydet</button>
            </form>
        </div>
    </div>
</div>
