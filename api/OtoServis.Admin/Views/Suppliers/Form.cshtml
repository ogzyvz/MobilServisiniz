@model SupplierFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Cari Düzenle" : "Yeni Cari";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small text-muted">← Cari listesi</a>
    <h1 class="page-title mt-1">@ViewData["Title"]</h1>
</div>

<div class="card-panel p-4" style="max-width:720px">
    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Contact" class="form-label fw-semibold"></label>
                <input asp-for="Contact" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label fw-semibold"></label>
                <input asp-for="Phone" class="form-control" placeholder="0555 123 45 67" />
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TaxNo" class="form-label fw-semibold"></label>
                <input asp-for="TaxNo" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label fw-semibold"></label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="OpeningBalance" class="form-label fw-semibold"></label>
                @if (isEdit)
                {
                    <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" readonly />
                    <span class="form-text small">Açılış bakiyesi kayıttan sonra değiştirilemez.</span>
                }
                else
                {
                    <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" />
                }
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4" style="background:#2f4a86;border:0">
                @(isEdit ? "Güncelle" : "Kaydet")
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
