@model CustomersIndexViewModel
@{
    ViewData["Title"] = "Müşteriler";
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success py-2">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2">@err</div>
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h1 class="page-title">Müşteriler</h1>
        <p class="text-muted mb-0">@Model.Items.Count kayıt</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3" style="background:#2f4a86;border:0">
        + Yeni Müşteri
    </a>
</div>

<form method="get" class="card-panel p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label small fw-semibold">Ara</label>
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="İsim veya telefon" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100" style="background:#2f4a86;border:0">Ara</button>
        </div>
    </div>
</form>

<div class="card-panel overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>Adres</th>
                    <th>Tip</th>
                    <th class="text-end" style="width:220px">İşlem</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
            }
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td class="fw-semibold">
                        @c.FullName
                        @if (c.IsSupplier)
                        {
                            <span class="badge text-bg-warning-subtle border text-warning-emphasis ms-1">Tedarikçi</span>
                        }
                    </td>
                    <td>@c.Phone</td>
                    <td class="text-muted small">@(c.Address ?? c.City ?? "-")</td>
                    <td><span class="badge text-bg-light border">@c.CustomerType</span></td>
                    <td class="text-end">
                        <a asp-controller="Vehicles" asp-action="Index" asp-route-customerId="@c.Id" class="btn btn-sm btn-outline-secondary">Araçları Gör</a>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Bu müşteri silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
