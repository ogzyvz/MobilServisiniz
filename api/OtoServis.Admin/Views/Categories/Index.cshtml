@model CategoriesIndexViewModel
@{
    ViewData["Title"] = "Kategoriler";
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success py-2">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2">@err</div>
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h1 class="page-title">Kategoriler</h1>
        <p class="text-muted mb-0">Stok ve servis kategorilerini yönetin.</p>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="categoryTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="stock-tab" data-bs-toggle="tab" data-bs-target="#stock-pane"
                type="button" role="tab" aria-controls="stock-pane" aria-selected="true">
            Stok Kategorileri <span class="badge text-bg-light border">@Model.StockCategories.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="service-tab" data-bs-toggle="tab" data-bs-target="#service-pane"
                type="button" role="tab" aria-controls="service-pane" aria-selected="false">
            Servis Kategorileri <span class="badge text-bg-light border">@Model.ServiceCategories.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="categoryTabsContent">
    <div class="tab-pane fade show active" id="stock-pane" role="tabpanel" aria-labelledby="stock-tab">
        <div class="d-flex justify-content-end mb-2">
            <a asp-action="CreateStock" class="btn btn-primary btn-sm px-3" style="background:#2f4a86;border:0">
                + Yeni Stok Kategorisi
            </a>
        </div>
        <div class="card-panel overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Kod</th>
                            <th>Etiket</th>
                            <th>Sıra</th>
                            <th>Kullanım</th>
                            <th class="text-end" style="width:220px">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.StockCategories.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
                    }
                    @foreach (var c in Model.StockCategories)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Code</td>
                            <td>@c.Label</td>
                            <td>@c.SortOrder</td>
                            <td><span class="badge text-bg-light border">@c.UsageCount ürün</span></td>
                            <td class="text-end">
                                <a asp-action="EditStock" asp-route-code="@c.Code" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <form asp-action="DeactivateStock" asp-route-code="@c.Code" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu stok kategorisi silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(c.UsageCount > 0)"
                                            title="@(c.UsageCount > 0 ? "Kullanımda olan kategoriler silinemez" : "")">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="service-pane" role="tabpanel" aria-labelledby="service-tab">
        <div class="d-flex justify-content-end mb-2">
            <a asp-action="CreateService" class="btn btn-primary btn-sm px-3" style="background:#2f4a86;border:0">
                + Yeni Servis Kategorisi
            </a>
        </div>
        <div class="card-panel overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Kod</th>
                            <th>Etiket</th>
                            <th>Sıra</th>
                            <th>Kullanım</th>
                            <th class="text-end" style="width:220px">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.ServiceCategories.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
                    }
                    @foreach (var c in Model.ServiceCategories)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Code</td>
                            <td>@c.Label</td>
                            <td>@c.SortOrder</td>
                            <td><span class="badge text-bg-light border">@c.UsageCount hizmet</span></td>
                            <td class="text-end">
                                <a asp-action="EditService" asp-route-code="@c.Code" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <form asp-action="DeactivateService" asp-route-code="@c.Code" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu servis kategorisi silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(c.UsageCount > 0)"
                                            title="@(c.UsageCount > 0 ? "Kullanımda olan kategoriler silinemez" : "")">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
