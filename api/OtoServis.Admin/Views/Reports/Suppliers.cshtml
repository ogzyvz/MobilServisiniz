@model SupplierReportViewModel
@{
    ViewData["Title"] = "Cari Raporu";
    var periodLabel = Model.Period == "weekly" ? "Haftalık" : "Günlük";
    ViewData["Subtitle"] = $"{periodLabel} · {Model.Date:dd.MM.yyyy} · {Model.Rows.Count} cari hareketi";
}

<partial name="_ReportHeader" />

<form method="get" class="card-panel p-3 mb-3 no-print">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Periyot</label>
            <select name="period" class="form-select" onchange="this.form.submit()">
                @if (Model.Period == "weekly")
                {
                    <option value="daily">Günlük</option>
                    <option value="weekly" selected="selected">Haftalık</option>
                }
                else
                {
                    <option value="daily" selected="selected">Günlük</option>
                    <option value="weekly">Haftalık</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Tarih</label>
            <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" />
        </div>
    </div>
</form>

<div class="row g-3 mb-3 no-print">
    <div class="col-md-4"><div class="stat-card"><div class="label">Toplam Alış</div><div class="value" style="font-size:1.4rem">@Model.TotalPurchases.ToString("N2") ₺</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="label">Toplam İade</div><div class="value" style="font-size:1.4rem">@Model.TotalReturns.ToString("N2") ₺</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="label">Cari Sayısı</div><div class="value" style="font-size:1.4rem">@Model.Rows.Count</div></div></div>
</div>

<div class="card-panel overflow-hidden report-table">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Cari</th>
                    <th class="text-end">Hareket</th>
                    <th class="text-end">Alış</th>
                    <th class="text-end">İade</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
            }
            @{ var i = 0; }
            @foreach (var row in Model.Rows)
            {
                i++;
                <tr>
                    <td class="text-muted">@i</td>
                    <td class="fw-semibold">@row.SupplierName</td>
                    <td class="text-end">@row.TransactionCount</td>
                    <td class="text-end text-warning">@row.TotalPurchases.ToString("N2") ₺</td>
                    <td class="text-end text-info">@row.TotalReturns.ToString("N2") ₺</td>
                </tr>
            }
            </tbody>
            @if (Model.Rows.Count > 0)
            {
                <tfoot class="table-light">
                    <tr>
                        <th colspan="3" class="text-end">Toplam</th>
                        <th class="text-end">@Model.TotalPurchases.ToString("N2") ₺</th>
                        <th class="text-end">@Model.TotalReturns.ToString("N2") ₺</th>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
