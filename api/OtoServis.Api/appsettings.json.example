{
  "ConnectionStrings": {
    "Default": "Server=YOUR_SERVER;Database=OtoServis;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=True;"
  },
  "Jwt": {
    "Key": "CHANGE-ME-Min32Chars-Secret-Key!",
    "Issuer": "OtoServis.Api",
    "Audience": "OtoServis.Mobile",
    "ExpireHours": 24
  },
  "Cors": {
    "Origins": [ "http://localhost:8081", "http://localhost:19006", "*" ]
  },
  "Ai": {
    "GeminiApiKey": "YOUR_GEMINI_API_KEY",
    "OpenAiApiKey": "YOUR_OPENAI_API_KEY_OPTIONAL",
    "Providers": [
      { "Name": "gemini", "Model": "gemini-3.5-flash-lite" },
      { "Name": "gemini", "Model": "gemini-3.5-flash" },
      { "Name": "openai", "Model": "gpt-4o-mini" },
      { "Name": "ocr", "Model": "tesseract" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
