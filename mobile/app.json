{
  "expo": {
    "name": "MobilServisiniz",
    "slug": "mobilservisiniz",
    "version": "1.0.31",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otoservis.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Ruhsatı çekip araç bilgilerini otomatik doldurmak için kamera erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Ruhsat fotoğrafını seçmek için galeri erişimi gereklidir."
      }
    },
    "android": {
      "package": "com.efogy.mobilservisiniz",
      "versionCode": 35,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1e3a6e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ruhsatı çekip araç bilgilerini otomatik doldurmak için kamera erişimi gereklidir.",
          "photosPermission": "Ruhsat fotoğrafını seçmek için galeri erişimi gereklidir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "infoPlist": {
              "NSAppTransportSecurity": {
                "NSAllowsArbitraryLoads": true
              }
            }
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ]
  }
}
